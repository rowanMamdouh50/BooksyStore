                          <Font name="Vladimir Script" size="24" style="0"/>
                        </Property>
                        <Property name="rows" type="int" value="5"/>
                        <Property name="text" type="java.lang.String" value="Welcome to Booksy Store your trusted destination for discovering great books!&#xa;&#xa;At Booksy Store , we believe that every book holds the power to inspire, educate, and entertain.&#xa;Our mission is to connect readers of all ages with stories and knowledge from around the world. &#xa;Whether you&apos;re searching for bestselling novels, timeless classics, children&apos;s adventures,&#xa; or the latest in non-fiction, you&apos;ll find a carefully curated selection right here.&#xa;&#xa;We are passionate about making reading accessible and enjoyable for everyone.&#xa;That&apos;s why we offer easy browsing, secure checkout, and fast delivery, all from the comfort of your &#xa;home.&#xa;Our team is made up of fellow book lovers who are always ready to help you find your next great&#xa; read.&#xa;&#xa;Thank you for choosing [Bookstore Name]. Happy reading!"/>
                      </Properties>
                    </Component>
                  </SubComponents>
                </Container>
